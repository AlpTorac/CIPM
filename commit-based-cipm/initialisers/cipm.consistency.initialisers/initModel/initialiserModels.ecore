      <eParameters name="objToInit" lowerBound="1" eType="ecore:EClass http://www.emftext.org/java/variables#//AdditionalLocalVariable"/>
      <eParameters name="newFeatVal" lowerBound="1" eType="ecore:EClass http://www.emftext.org/java/types#//TypeReference"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="initialisedElems" upperBound="-1"
        eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
  </eClassifiers>
</ecore:EPackage>
